;;; round-two-tests.el --- Shared binding and extension index regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'core-modules)

(defmacro mcg-test-round-two-extensions (&rest body)
  "Run BODY against an isolated extension tree."
  (declare (indent 0))
  `(let* ((root (make-temp-file "mcg-round-two" t))
          (mcg-extensions-dir root)
          (mcg-extension-cache nil)
          (mcg-extension-cache-file nil)
          (mcg-cache-dir nil)
          (mcg-extension-cache-validate-signature t)
          (mcg-extension-discovery-max-depth 3)
          (load-path (copy-sequence load-path)))
     (unwind-protect (progn ,@body) (delete-directory root t))))

(defun mcg-test-round-two-package (root relative)
  "Create a package at RELATIVE under ROOT and return its directory."
  (let ((dir (expand-file-name relative root)))
    (make-directory dir t)
    (write-region "(provide 'fixture)" nil (expand-file-name "fixture.el" dir))
    dir))

(ert-deftest mcg-round-two-bootstrap-prefers-lisp-over-dir-locals ()
  (mcg-test-round-two-extensions
    (let* ((package (expand-file-name "group/package" root))
           (lisp (mcg-test-round-two-package root "group/package/lisp")))
      (write-region "nil" nil (expand-file-name ".dir-locals.el" package))
      (mcg--add-extensions-to-load-path root)
      (should (member (file-name-as-directory lisp) load-path))
      (should-not (member (file-name-as-directory package) load-path))
      (should (equal (mcg-extension-path 'package) lisp)))))

(ert-deftest mcg-round-two-nested-package-addition-invalidates-cache ()
  (mcg-test-round-two-extensions
    (mcg-test-round-two-package root "group/old")
    (make-directory (expand-file-name "group/sub" root) t)
    (let* ((group (expand-file-name "group" root))
           (mtime (file-attribute-modification-time (file-attributes group))))
      (mcg-list-extensions)
      (let ((added (mcg-test-round-two-package root "group/sub/new")))
        ;; Hold shallow timestamps constant to expose the old signature bug.
        (set-file-times group mtime)
        (should (equal (mcg-extension-path 'new) added))))))

(ert-deftest mcg-round-two-nested-package-removal-invalidates-cache ()
  (mcg-test-round-two-extensions
    (let* ((package (mcg-test-round-two-package root "group/sub/old"))
           (group (expand-file-name "group" root))
           (mtime (file-attribute-modification-time (file-attributes group))))
      (should (mcg-extension-path 'old))
      (delete-directory package t)
      (set-file-times group mtime)
      (should-not (mcg-extension-path 'old)))))

(ert-deftest mcg-round-two-empty-index-is-cached ()
  (mcg-test-round-two-extensions
    (mcg-list-extensions)
    (cl-letf (((symbol-function 'mcg--discover-extensions-recursive)
               (lambda (&rest _) (ert-fail "Empty index was rediscovered"))))
      (should-not (mcg-list-extensions)))))

(ert-deftest mcg-round-two-direct-lookup-obeys-index-exclusions-and-depth ()
  (mcg-test-round-two-extensions
    (mcg-test-round-two-package root "tests")
    (mcg-test-round-two-package root "group/sub/deep")
    (let ((mcg-extension-discovery-max-depth 1))
      (should-not (mcg-extension-direct-path 'tests))
      (should-not (mcg-extension-direct-path 'deep)))))

(ert-deftest mcg-round-two-prefix-setup-preserves-existing-children ()
  (let ((global-map (make-sparse-keymap))
        (mcg-keybinding-registry nil)
        (mcg-keybinding-conflicts nil))
    (define-key global-map (kbd "C-c s b") 'ignore)
    (mcg-ensure-prefix-map "C-c s" 'mcg-test-search-map "test")
    (should (eq (lookup-key global-map (kbd "C-c s b")) 'ignore))
    (mcg-ensure-prefix-map "C-c s" 'mcg-test-search-map "test")
    (should (eq (lookup-key global-map (kbd "C-c s b")) 'ignore))))

(ert-deftest mcg-round-two-majutsu-custom-key-is-shared ()
  (require 'core-bindings)
  (let ((global-map (make-sparse-keymap))
        (mcg-tools-majutsu-prefix "C-c j")
        (mcg-keybinding-registry nil)
        (mcg-keybinding-conflicts nil))
    (cl-letf (((symbol-function 'mcg-define-lazy-module-command) #'ignore))
      (mcg-bind-module-commands :tools 'majutsu t))
    (should (eq (lookup-key global-map (kbd "C-c j")) 'majutsu))
    (should-not (eq (lookup-key global-map (kbd "C-x M-j")) 'majutsu))
    (mcg-bind-module-commands :tools 'majutsu)
    (should-not mcg-keybinding-conflicts)))

(ert-deftest mcg-round-two-lazy-autoload-runs-module-setup-first ()
  (let* ((command 'mcg-test-round-two-autoload)
         (original '(autoload "unused-fixture" nil t))
         (mcg-loaded-modules nil)
         events)
    (unwind-protect
        (progn
          (fset command original)
          (mcg-define-lazy-module-command :test 'fixture command)
          (cl-letf (((symbol-function 'mcg-load-module)
                     (lambda (&rest _)
                       (push 'setup events)
                       (fset command (lambda () (interactive) (push 'command events)))
                       t)))
            (call-interactively command)
            (should (equal (nreverse events) '(setup command)))))
      (fmakunbound command))))

(ert-deftest mcg-round-two-lazy-existing-command-preserves-lisp-arguments ()
  (let ((command 'mcg-test-round-two-existing)
        (mcg-loaded-modules nil))
    (unwind-protect
        (progn
          (fset command (lambda (value) (interactive "p") (* value 2)))
          (mcg-define-lazy-module-command :test 'fixture command)
          (cl-letf (((symbol-function 'mcg-load-module) (lambda (&rest _) t)))
            (should (= (funcall command 21) 42))))
      (fmakunbound command))))

(ert-deftest mcg-round-two-lazy-failed-setup-can-retry-loaded-package ()
  (let ((command 'mcg-test-round-two-retry)
        (mcg-loaded-modules nil)
        (attempts 0))
    (unwind-protect
        (progn
          (fmakunbound command)
          (mcg-define-lazy-module-command :test 'fixture command)
          (cl-letf (((symbol-function 'mcg-load-module)
                     (lambda (&rest _)
                       (cl-incf attempts)
                       (when (= attempts 1)
                         (fset command (lambda () (interactive) 'executed)))
                       (> attempts 1))))
            (should-error (call-interactively command) :type 'user-error)
            (should (eq (call-interactively command) 'executed))
            (should (= attempts 2))))
      (fmakunbound command))))

(ert-deftest mcg-round-two-shared-bindings-survive-formal-setup-and-reload ()
  (require 'core-bindings)
  (let ((global-map (make-sparse-keymap))
        (mcg-keybinding-registry nil)
        (mcg-keybinding-conflicts nil))
    (cl-letf (((symbol-function 'mcg-define-lazy-module-command) #'ignore))
      (dolist (entry mcg-module-command-bindings)
        (mcg-bind-module-commands (nth 0 entry) (nth 1 entry) t)))
    ;; Consult takes ownership of the shared prefix after lazy entries exist.
    (mcg-ensure-prefix-map "C-c s" 'mcg-search-map "completion/consult")
    (define-key global-map (kbd "C-c s l") 'consult-line)
    (dotimes (_ 2)
      (dolist (entry mcg-module-command-bindings)
        (mcg-bind-module-commands (nth 0 entry) (nth 1 entry))))
    (should (eq (lookup-key global-map (kbd "C-c s b")) 'blink-search))
    (should (eq (lookup-key global-map (kbd "C-c s g")) 'color-rg-search-input))
    (should (eq (lookup-key global-map (kbd "C-c s l")) 'consult-line))
    (should (eq (lookup-key global-map (kbd "C-c c t")) 'mcg-compile-test))
    (should-not mcg-keybinding-conflicts)))

(ert-deftest mcg-round-two-duplicate-package-resolution-is-consistent ()
  (mcg-test-round-two-extensions
    (let ((first (mcg-test-round-two-package root "a/duplicate")))
      (mcg-test-round-two-package root "b/duplicate")
      (should (= (length (mcg-list-extensions)) 1))
      (should (equal (mcg-extension-path 'duplicate) first))
      (should (equal (mcg-extension-direct-path 'duplicate) first)))))

(ert-deftest mcg-round-two-cache-validation-follows-discovery-options ()
  (mcg-test-round-two-extensions
    (mcg-test-round-two-package root "group/package")
    (should (mcg-extension-path 'package))
    (let ((mcg-extension-discovery-max-depth 1))
      (should-not (mcg-extension-path 'package)))
    (let ((mcg-extension-load-path-excluded-dirs '("group")))
      (should-not (mcg-extension-path 'package)))))

(ert-deftest mcg-round-two-valid-index-does-not-rescan-el-files ()
  (mcg-test-round-two-extensions
    (let ((package (mcg-test-round-two-package root "group/package")))
      (should (equal (mcg-extension-path 'package) package))
      (cl-letf (((symbol-function 'mcg--find-el-files-in-dir)
                 (lambda (&rest _) (ert-fail "Valid cache rescanned source files"))))
        (should (equal (mcg-extension-path 'package) package))))))

(ert-deftest mcg-round-two-index-tracks-new-top-level-and-lisp-directories ()
  (mcg-test-round-two-extensions
    (mcg-list-extensions)
    (let ((package (mcg-test-round-two-package root "new")))
      (should (equal (mcg-extension-path 'new) package))
      (let ((lisp (mcg-test-round-two-package root "new/lisp")))
        (should (equal (mcg-extension-path 'new) lisp))))))

(ert-deftest mcg-round-two-startup-exposes-only-enabled-idle-bindings ()
  (require 'core-bindings)
  (mcg-test-round-one-init-functions)
  (let (bound)
    (cl-letf (((symbol-function 'mcg-module-enabled-p)
               (lambda (_category module) (not (eq module 'magit))))
              ((symbol-function 'mcg-module-load-strategy)
               (lambda (_category module) (if (eq module 'compile) 'idle 'immediate)))
              ((symbol-function 'mcg-bind-module-commands)
               (lambda (category module lazy) (push (list category module lazy) bound))))
      (mcg-setup-idle-module-command-entries)
      (should (equal bound '((:tools compile t)))))))

(provide 'round-two-tests)
