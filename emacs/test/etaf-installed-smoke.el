;;; etaf-installed-smoke.el --- Optional installed ETAF workflow -*- lexical-binding: t; -*-

;; Run explicitly after M-x mcg-etaf-install; not part of dependency-free ERT.
(require 'cl-lib)
(load (expand-file-name "../scripts/profile-startup.el"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t)

(dolist (feature '(etaf-install ecss ebox etaf etaf-ui etaf-manual etaf-md-preview))
  (when (featurep feature)
    (error "Startup eagerly loaded %s" feature)))

(defun mcg-test-etaf-rendered-buffer (buffer)
  "Check that BUFFER contains a mounted ETAF application."
  (unless (and (buffer-live-p buffer)
               (etaf-runtime-for-buffer buffer)
               (> (buffer-size buffer) 0))
    (error "ETAF did not render a mounted buffer: %S" buffer))
  (princ (format "Rendered %s: %d characters\n" (buffer-name buffer)
                 (buffer-size buffer))))

(let ((source (make-temp-file "mcg-etaf-preview" nil ".md"))
      gallery manual preview)
  (unwind-protect
      (cl-letf (((symbol-function 'package-refresh-contents)
                 (lambda (&rest _) (error "Offline smoke attempted archive refresh")))
                ((symbol-function 'package-install)
                 (lambda (&rest _) (error "Offline smoke attempted installation")))
                ((symbol-function 'url-retrieve-synchronously)
                 (lambda (&rest _) (error "Offline smoke attempted download"))))
        (mcg-etaf-manage)
        (dolist (command '(etaf-ui-gallery-open etaf-manual-open etaf-md-preview-open))
          (unless (commandp command)
            (error "Manager did not prepare installed command %s" command)))
        (setq gallery (mcg-etaf-gallery))
        (mcg-test-etaf-rendered-buffer gallery)
        (setq manual (mcg-etaf-manual))
        (mcg-test-etaf-rendered-buffer manual)
        (with-temp-file source (insert "# ETAF smoke\n\nOffline Markdown preview.\n"))
        (with-current-buffer (find-file-noselect source)
          (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) source)))
            (setq preview (mcg-etaf-markdown-preview))))
        (mcg-test-etaf-rendered-buffer preview)
        (mcg-etaf--require-installer)
        (dolist (target mcg-etaf-packages)
          (let ((report (etaf-install-doctor target)))
            (unless (plist-get report :ready)
              (error "ETAF target is not ready: %S" report))))
        (unless (eq (plist-get (mcg-etaf-check) :status) :ok)
          (error "Local ETAF health check failed"))
        (princ "Installed ETAF gallery, manual and Markdown offline workflows: passed\n"))
    (when (timerp mcg-idle-load-timer) (cancel-timer mcg-idle-load-timer))
    (dolist (buffer (list preview manual gallery (get-file-buffer source)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))
    (delete-file source)))
