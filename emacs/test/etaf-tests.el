;;; etaf-tests.el --- Optional ETAF integration regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'package)

(defmacro mcg-test-etaf (&rest body)
  "Load the optional integration and run BODY with isolated package state."
  (declare (indent 0))
  `(progn
     (should (require 'init-etaf nil t))
     (let ((package--initialized t)
           (package-alist nil)
           (package-activated-list nil)
           (package-archives '(("gnu" . "https://elpa.gnu.org/packages/"))))
       (cl-letf (((symbol-function 'mcg-etaf--source-conflicts) (lambda () nil)))
         ,@body))))

(ert-deftest mcg-etaf-module-startup-is-offline-and-repeatable ()
  (cl-letf (((symbol-function 'package-refresh-contents)
             (lambda (&rest _) (ert-fail "Startup refreshed archives")))
            ((symbol-function 'package-install)
             (lambda (&rest _) (ert-fail "Startup installed a package")))
            ((symbol-function 'package-initialize)
             (lambda (&rest _) (ert-fail "Startup initialized packages")))
            ((symbol-function 'package-activate)
             (lambda (&rest _) (ert-fail "Startup activated a package"))))
    (let ((file (expand-file-name "site-lisp/config/modules/tools/init-etaf.el"
                                  mcg-test-root)))
      (should (file-exists-p file))
      (load file nil t)
      (load file nil t)
      (dolist (command '(mcg-etaf-install mcg-etaf-manage mcg-etaf-doctor
                         mcg-etaf-gallery mcg-etaf-manual mcg-etaf-markdown-preview))
        (should (commandp command))))))

(ert-deftest mcg-etaf-open-missing-package-does-not-install ()
  (mcg-test-etaf
    (cl-letf (((symbol-function 'package-installed-p) (lambda (&rest _) nil))
              ((symbol-function 'package-install)
               (lambda (&rest _) (ert-fail "Open installed a package")))
              ((symbol-function 'package-refresh-contents)
               (lambda (&rest _) (ert-fail "Open refreshed archives"))))
      (let ((err (should-error (mcg-etaf-gallery) :type 'user-error)))
        (should (string-match-p "mcg-etaf-install" (error-message-string err)))))))

(ert-deftest mcg-etaf-open-activates-only-its-target-and-keeps-buffer-context ()
  (mcg-test-etaf
    (let ((original-require (symbol-function 'require)) activated opened required)
      (cl-letf (((symbol-function 'package-installed-p) (lambda (&rest _) t))
                ((symbol-function 'require)
                 (lambda (feature &rest args)
                   (if (eq feature 'etaf-md-preview) (setq required feature)
                     (apply original-require feature args))))
                ((symbol-function 'package-activate)
                 (lambda (name &rest _) (push name activated) t))
                ((symbol-function 'etaf-md-preview-open)
                 (lambda () (interactive) (setq opened (current-buffer)))))
        (with-temp-buffer
          (let ((source (current-buffer)))
            (mcg-etaf-markdown-preview)
            (should (eq opened source))))
        (should (equal activated '(etaf-md-preview)))
        (should (eq required 'etaf-md-preview))))))

(ert-deftest mcg-etaf-package-discovery-does-not-activate-unrelated-packages ()
  (mcg-test-etaf
    (let ((package--initialized nil) discovery)
      (cl-letf (((symbol-function 'package-initialize)
                 (lambda (&optional no-activate)
                   (setq discovery no-activate package--initialized t)))
                ((symbol-function 'package-installed-p) (lambda (&rest _) nil)))
        (should-error (mcg-etaf-gallery) :type 'user-error)
        (should discovery)))))

(ert-deftest mcg-etaf-install-uses-official-installer-for-approved-targets ()
  (mcg-test-etaf
    (let (installed targets refreshed)
      (cl-letf (((symbol-function 'package-installed-p)
                 (lambda (name &rest _) (memq name installed)))
                ((symbol-function 'package-refresh-contents)
                 (lambda (&rest _) (setq refreshed (copy-tree package-archives))))
                ((symbol-function 'package-install)
                 (lambda (name &rest _) (push name installed)))
                ((symbol-function 'package-activate) (lambda (&rest _) t))
                ((symbol-function 'mcg-etaf--require-installer) #'ignore)
                ((symbol-function 'etaf-install)
                 (lambda (name no-open) (push (list name no-open) targets))))
        (mcg-etaf-install)
        (should (equal (reverse targets)
                       '((etaf-ui t) (etaf-manual t) (etaf-md-preview t))))
        (should (equal installed '(etaf-install)))
        (should (equal refreshed '(("etaf" . "https://etaf.top/packages/"))))
        (should (assoc "gnu" package-archives))))))

(ert-deftest mcg-etaf-source-conflict-is-detected-before-activation ()
  (should (require 'init-etaf nil t))
  (let* ((root (make-temp-file "mcg-etaf-source" t))
         (load-path (cons root load-path)))
    (unwind-protect
        (progn
          (write-region "(provide 'ecss)" nil (expand-file-name "ecss.el" root))
          (let ((package--initialized t) (package-alist nil))
            (should (mcg-etaf--source-conflicts))
            (cl-letf (((symbol-function 'package-activate)
                       (lambda (&rest _) (ert-fail "Activated conflicting sources"))))
              (should-error (mcg-etaf-gallery) :type 'user-error))))
      (delete-directory root t))))

(ert-deftest mcg-etaf-manage-prepares-installed-targets-before-opening-manager ()
  (mcg-test-etaf
    (let ((original-require (symbol-function 'require)) prepared managed)
      (cl-letf (((symbol-function 'mcg-etaf--require-installer) #'ignore)
                ((symbol-function 'package-installed-p)
                 (lambda (name &rest _) (memq name '(etaf-ui etaf-manual))))
                ((symbol-function 'package-activate) (lambda (&rest _) t))
                ((symbol-function 'require)
                 (lambda (feature &rest args)
                   (if (memq feature mcg-etaf-packages) (push feature prepared)
                     (apply original-require feature args))))
                ((symbol-function 'etaf-install-manage)
                 (lambda () (interactive)
                   (should (equal (reverse prepared) '(etaf-ui etaf-manual)))
                   (setq managed t))))
        (mcg-etaf-manage)
        (should managed)))))

(ert-deftest mcg-etaf-doctor-is-offline-and-reports-optional-sqlite ()
  (mcg-test-etaf
    (cl-letf (((symbol-function 'package-installed-p) (lambda (&rest _) nil))
              ((symbol-function 'sqlite-available-p) (lambda () nil))
              ((symbol-function 'package-refresh-contents)
               (lambda (&rest _) (ert-fail "Doctor accessed network")))
              ((symbol-function 'package-install)
               (lambda (&rest _) (ert-fail "Doctor installed packages"))))
      (let ((health (mcg-etaf-check)))
        (should (eq (plist-get health :status) :warning))
        (should (string-match-p "SQLite" (plist-get health :message)))
        (should (string-match-p "mcg-etaf-install" (plist-get health :action)))))))

;;; etaf-tests.el ends here
